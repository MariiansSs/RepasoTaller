@model ReservaIndexViewModel

@{
    ViewData["Title"] = "Reservas";
}

<h1>Reservas</h1>

<p>
    <a asp-action="Crear" class="btn btn-primary">Nueva reserva</a>
</p>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row align-items-end">
        <div class="col-md-4">
            <label asp-for="Estado" class="form-label">Filtrar por estado</label>
            <select asp-for="Estado"
                    asp-items="Html.GetEnumSelectList<EstadoReserva>()"
                    class="form-select">
                <option value="">Todos</option>
            </select>
        </div>

        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        </div>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>ID</th>
            <th>Vuelo</th>
            <th>Ruta</th>
            <th>Salida</th>
            <th>Pasajero</th>
            <th>Asiento</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var reserva in Model.Reservas)
        {
            <tr>
                <td>@reserva.Id</td>
                <td>@reserva.Vuelo</td>
                <td>@reserva.Ruta</td>
                <td>@reserva.Salida</td>
                <td>@reserva.Pasajero</td>
                <td>@reserva.Asiento</td>
                <td>@reserva.Estado</td>
                <td>
                    <a asp-action="Detalle"
                       asp-route-id="@reserva.Id"
                       class="btn btn-info btn-sm">
                        Detalle
                    </a>

                    @if (!reserva.Cancelada)
                    {
                        <a asp-action="Cancelar"
                           asp-route-id="@reserva.Id"
                           class="btn btn-danger btn-sm">
                            Cancelar
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Reservas.Any())
{
    <div class="alert alert-info">
        No se encontraron reservas.
    </div>
}
